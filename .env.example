# Copy to .env. These are placeholders, never usable production credentials.
# See README.md for Docker versus native DATABASE_URL hostnames.
POSTGRES_USER=coach
POSTGRES_PASSWORD=change-me
POSTGRES_DB=coach
DATABASE_URL=postgresql+psycopg://coach:change-me@db:5432/coach

# Production requires public HTTPS frontend origins and a TLS PostgreSQL URL.
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=10

# Restricted private staging. See docs/private-staging-checklist.md.
STAGING_ENABLED=false
# Explicit public access retains staging quotas; invite_only is the safe default.
STAGING_ACCESS_MODE=invite_only
STAGING_ALLOWED_EMAILS=[]
STAGING_REGISTRATION_ENABLED=false
AI_ENABLED=true
SPEECH_ENABLED=true
AI_GLOBAL_CONCURRENCY=8
STAGING_AI_USER_DAILY_LIMIT=30
STAGING_AI_GLOBAL_DAILY_LIMIT=100
# Empty means trust no forwarded client headers. Never use '*'.
FORWARDED_ALLOW_IPS=

# Required: set a non-placeholder secret of at least 32 bytes before starting.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Choose one generation provider: azure_openai or gemini. No automatic chain.
LLM_PROVIDER=azure_openai
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Use the model/deployment name enabled for your Azure Responses API endpoint.
AZURE_OPENAI_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=60

# Gemini is also used independently for retrieval/document embeddings.
GEMINI_API_KEY=
# Required when LLM_PROVIDER=gemini; verify model availability for your account.
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Optional Voice Mode. Keep the subscription key on the backend only.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# Public frontend setting, not a credential.
VITE_API_URL=http://localhost:8000
